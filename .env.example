# Copy to .env (git-ignored) and adjust. Never commit .env.

# Local PostgreSQL + pgvector (docker-compose.dev.yml)
DATABASE_URL=postgresql://drugsafety:drugsafety@localhost:5432/drugsafety

# Raw source files, caches and run outputs
DATA_DIR=data

# Model server (vLLM on Google Colab for now: notebooks/colab_qwen_vllm.ipynb prints these)
MODEL_URL=http://localhost:8000/v1
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_API_KEY=local
MODEL_GUIDED_JSON=false
MODEL_MAX_TOKENS=1500
MODEL_TIMEOUT_S=180
LLM_CONTEXT_TOKENS=3500

# Must match stored vectors; changing it means re-embedding every chunk
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Person A's FastAPI service, used by the Streamlit UI
API_URL=http://localhost:8080
API_TIMEOUT_S=420

LOG_LEVEL=INFO
SCOPE_FILE=scope/v1.yaml

# Optional: free keys that raise rate limits
NCBI_API_KEY=
OPENFDA_API_KEY=
